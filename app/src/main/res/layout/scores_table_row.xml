<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/score_table_item_row"
    android:layout_width="match_parent"
    android:layout_height="@dimen/score_table_row_height"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    >

    <TextView
        android:id="@+id/score_table_item_index"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
        tools:text="1"
        />

    <ImageView
        android:id="@+id/score_table_item_icon"
        android:layout_width="@dimen/score_table_row_height"
        android:layout_height="@dimen/score_table_row_height"
        android:padding="4dp"
        tools:src="@drawable/icon_ajax"
        tools:ignore="ContentDescription"
        />

    <TextView
        android:id="@+id/score_table_item_name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:minWidth="100dp"
        android:gravity="center_vertical"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        android:labelFor="@id/score_table_item_icon"
        tools:text="Ajax"
        tools:ignore="LabelFor"
        />

    <TextView
        android:id="@+id/score_table_item_games"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="6"
        />

    <TextView
        android:id="@+id/score_table_item_wins"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="4"
        />

    <TextView
        android:id="@+id/score_table_item_draws"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="0"
        />

    <TextView
        android:id="@+id/score_table_item_losses"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="2"
        />

    <TextView
        android:id="@+id/score_table_item_goals_scored"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="18"
        />

    <TextView
        android:id="@+id/score_table_item_goals_against"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="10"
        />

    <TextView
        android:id="@+id/score_table_item_goals_difference"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="8"
        />

    <TextView
        android:id="@+id/score_table_item_points"
        android:layout_width="@dimen/score_table_cell_width"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
        tools:text="12"
        />

</LinearLayout>